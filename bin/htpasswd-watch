#!/bin/sh
# htpasswd-watch — lance un service et le notifie quand son fichier d'authentification change.
#
# Beaucoup de services ne lisent leur fichier de mots de passe qu'au démarrage (Mailpit) ou
# ne le relisent que sur signal (NATS, Nginx : SIGHUP). htpasswd-watch tourne dans le conteneur
# du service, surveille le fichier par sondage (inode, date, taille) et, à chaque modification :
#   - relance le service (mode par défaut, ex. Mailpit) ;
#   - ou lui envoie un signal (--signal HUP, ex. NATS, Nginx).
# Aucun accès à Docker n'est nécessaire. POSIX sh : fonctionne dans toute image Alpine ou Debian.
#
# Usage : htpasswd-watch [-f FICHIER] [-i SECONDES] [-s SIGNAL] -- commande [arguments...]
set -u

usage() {
  cat >&2 <<'USAGE'
Usage : htpasswd-watch [options] -- commande [arguments...]

  -f, --file FICHIER      fichier surveillé (défaut : $HTPASSWD_WATCH_FILE)
  -i, --interval SECONDES période de sondage (défaut : $HTPASSWD_WATCH_INTERVAL ou 2)
  -s, --signal SIGNAL     envoyer ce signal au service au lieu de le relancer (ex. HUP)
  -h, --help              afficher cette aide

Exemples :
  htpasswd-watch -f /auth/passwords -- /mailpit
  htpasswd-watch -f /auth/users.conf -s HUP -- nats-server -c /etc/nats/nats.conf
USAGE
  exit "${1:-2}"
}

log() { echo "htpasswd-watch: $*" >&2; }

FILE="${HTPASSWD_WATCH_FILE:-}"
INTERVAL="${HTPASSWD_WATCH_INTERVAL:-2}"
SIGNAL=''

while [ $# -gt 0 ]; do
  case "$1" in
    -f|--file) [ $# -ge 2 ] || usage; FILE=$2; shift 2 ;;
    -i|--interval) [ $# -ge 2 ] || usage; INTERVAL=$2; shift 2 ;;
    -s|--signal) [ $# -ge 2 ] || usage; SIGNAL=${2#SIG}; shift 2 ;;
    -h|--help) usage 0 ;;
    --) shift; break ;;
    *) log "option inconnue : $1"; usage ;;
  esac
done

[ $# -gt 0 ] || { log "commande manquante après --"; usage; }
[ -n "$FILE" ] || { log "fichier à surveiller manquant (-f ou HTPASSWD_WATCH_FILE)"; usage; }
case "$INTERVAL" in ''|*[!0-9.]*) log "intervalle invalide : $INTERVAL"; exit 2 ;; esac
if [ -n "$SIGNAL" ] && ! kill -l "$SIGNAL" >/dev/null 2>&1; then log "signal inconnu : $SIGNAL"; exit 2; fi

# L'écriture atomique de htpasswd-manager (rename) change l'inode : détecté même dans la même seconde.
# stat GNU/BusyBox (-c), sinon BSD/macOS (-f).
fingerprint() { stat -c '%i %Y %s' "$FILE" 2>/dev/null || stat -f '%i %m %z' "$FILE" 2>/dev/null || echo absent; }

child=''
start() {
  "$@" &
  child=$!
}
stop() {
  if [ -n "$child" ] && kill -TERM "$child" 2>/dev/null; then wait "$child" 2>/dev/null; fi
}
# Arrêt du conteneur : on transmet au service et on sort avec lui.
trap 'stop; exit 0' TERM INT

last=$(fingerprint)
start "$@"
log "surveillance de $FILE toutes les ${INTERVAL}s ($([ -n "$SIGNAL" ] && echo "signal $SIGNAL" || echo relance))"

while :; do
  # sleep en arrière-plan : « wait » reste interruptible par SIGTERM (arrêt rapide).
  sleep "$INTERVAL" &
  wait $!

  # Le service s'est arrêté de lui-même : on propage son code (la politique de redémarrage décide).
  if ! kill -0 "$child" 2>/dev/null; then
    wait "$child"
    code=$?
    log "le service s'est arrêté (code $code)"
    exit "$code"
  fi

  current=$(fingerprint)
  [ "$current" = "$last" ] && continue
  last=$current

  if [ -n "$SIGNAL" ]; then
    log "$FILE modifié, envoi de SIG$SIGNAL"
    kill -s "$SIGNAL" "$child"
  else
    log "$FILE modifié, relance du service"
    stop
    start "$@"
  fi
done
