# Copier en .env puis adapter.  (cp .env.example .env && chmod 600 .env)
ADMIN_USER=admin
ADMIN_PASSWORD=changez-moi-avec-une-longue-phrase-de-passe
DEFAULT_ALGORITHM=bcrypt-2y
BCRYPT_COST=10
SHACRYPT_ROUNDS=5000
FILE_MODE=0640
HTPASSWD_UI_PORT=8080
# Webhook appelé après chaque modification (vide = désactivé). Exemple Dokploy :
# RELOAD_WEBHOOK_URL=https://dokploy.example.fr/api/application.reload
# RELOAD_WEBHOOK_HEADERS=x-api-key: <clé API Dokploy>
# RELOAD_WEBHOOK_BODY={"applicationId":"<id>","appName":"<nom>"}
RELOAD_WEBHOOK_URL=
