{
  "name": "htpasswd-manager",
  "version": "1.1.0",
  "description": "Micro-application web de gestion d'un fichier htpasswd (Mailpit / Apache / Nginx)",
  "type": "module",
  "main": "dist/server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.web.json && cp public/*.html public/*.css dist/public/",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json --noEmit",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "bcryptjs": "3.0.3",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
